# CSSbody {
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
    background: #f0f4f8;
    text-align: center;
}

.container {
    width: 80%;
    margin: 50px auto;
}

h1 {
    color: #222;
    font-size: 36px;
}

.device {
    display: inline-block;
    width: 200px;
    margin: 20px;
    padding: 25px;
    background: white;
    border-radius: 15px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
}

.device h2 {
    color: #333;
}

button {
    padding: 12px 25px;
    margin: 8px;
    border: none;
    border-radius: 8px;
    color: white;
    font-size: 16px;
    cursor: pointer;
}

.on {
    background-color: #28a745;
}

.off {
    background-color: #dc3545;
}

button:hover {
    opacity: 0.8;
}
